# HakiOS fragment: the sdm670 family -- what is true of the SoC, whatever device it is in.
# Napali (SDM670/SDM710): eight Kryo 360 cores, gold cluster ends at core 7.
# The sc7280-written SoC drivers (CPUFREQ/SOCINFO/THERMAL/PMIC) are NOT enabled yet:
# their built-in addresses are yupik's. Enable one at a time with sdm670 addresses
# (read from the R17's device tree) as boot-arguments in the device's fragment.
CONFIG_SOC="sdm670"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
# Napali shares these blocks' addresses with yupik (verified against the R17's own
# device tree: tsens tm blocks 0xc263000/0xc265000, spmi arbiter 0xc440000 --
# the same values the drivers have built in), so the reference implementations run as they are:
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y
CONFIG_SOCINFO=y
CONFIG_THERMAL=y
# CPUFREQ stays out: sdm670 predates EPSS (Napali uses the older OSM clock controller),
# the EPSS driver's register layout does not fit. Its own driver comes later.
# CPUFREQ 的启动地址是本机专属的，需要为 Napali 的时钟控制器写驱动后再开。
